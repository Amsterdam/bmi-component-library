{
	"$schema": "http://json.schemastore.org/swcrc",
	"jsc": {
		"target": "es5",
		"parser": {
			"syntax": "typescript",
			"tsx": true,
			"dynamicImport": true,
			"decorators": true
		},
		"baseUrl": "./",
		"paths": {
			"@mui/styled-engine": ["node_modules/@mui/styled-engine-sc"],
			"@common/*": ["src/common/src/*"],
			"@form/*": ["src/form/*"],
			"@theme/*": ["src/theme/*"],
			"@utils/*": ["src/utils/*"]
		},
		"transform": {
			"react": {
				"throwIfNamespace": true,
				"development": false,
				"runtime": "automatic"
			}
		}
	},
	"module": {
		"type": "commonjs"
	},
	"sourceMaps": true,
	"exclude": [".__mocks__\\*.ts$", ".*\\.stories.tsx", ".*\\.test.tsx?$"],
	"minify": true
}
